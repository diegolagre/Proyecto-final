{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAnalyticsBuckets",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:s3:::sap-analytics-migration-dev-landing",
        "arn:aws:s3:::sap-analytics-migration-dev-curated"
      ]
    },
    {
      "Sid": "ReadLanding",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::sap-analytics-migration-dev-landing/*"
    },
    {
      "Sid": "WriteCurated",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::sap-analytics-migration-dev-curated/*"
    }
  ]
}
